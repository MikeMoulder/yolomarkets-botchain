# Vercel mainnet configuration for the isolated YOLO Markets deployment.
# Set these in the Vercel project for Preview and Production as appropriate.

NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_BOTCHAIN_RPC_URLS=https://rpc.botchain.ai
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
NEXT_PUBLIC_FACTORY_ADDRESS=0x78b9d155c15907a2dc0cddc090d68bb31021b730
NEXT_PUBLIC_FACTORY_LEGACY_ADDRESS=
CATALOG_INCLUDE_LEGACY=0

# On-chain payment required before generating a market insight.
AI_INSIGHT_FEE_USDT=0.2
NEXT_PUBLIC_AI_INSIGHT_FEE_USDT=0.2
AI_INSIGHT_FEE_RECIPIENT=<mainnet-insight-recipient>
NEXT_PUBLIC_AI_INSIGHT_FEE_RECIPIENT=<mainnet-insight-recipient>

# Configure the provider secret separately in Vercel; never commit it here.
# OPENROUTER_API_KEY=<vercel-secret>
# or GEMINI_API_KEY=<vercel-secret>
