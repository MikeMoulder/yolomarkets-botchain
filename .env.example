# ──────────────────────────────────────────────────────────────────────────────
# Arc testnet
# ──────────────────────────────────────────────────────────────────────────────
# Public RPC (rate-limited):           https://rpc.testnet.arc.network
# dRPC public fallback:                https://arc-testnet.drpc.org
# Canteen-proxied RPC (token-gated):   arc-canteen rpc-url
BOTCHAIN_RPC_URL=https://rpc.bohr.life
BOTCHAIN_RPC_URLS=https://rpc.bohr.life
BOTCHAIN_CHAIN_ID=968

# Browser-side RPC list (wagmi). MUST contain only endpoints that send CORS
# headers — https://rpc.testnet.arc.network does NOT, so it belongs on the
# server list above and nowhere near this one. Optional; lib/wagmi.ts ships the
# same three defaults if unset.
NEXT_PUBLIC_BOTCHAIN_RPC_URLS=https://rpc.bohr.life
NEXT_PUBLIC_CHAIN_ID=968

# USDC ERC-20 interface on Arc (6 decimals). Native gas USDC uses 18 decimals.
SETTLEMENT_TOKEN_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3

# Set these after deploying MarketFactory to the selected BOT network.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_FACTORY_LEGACY_ADDRESS=
# Set to 1 to show still-open markets from the frozen legacy factory.
CATALOG_INCLUDE_LEGACY=0
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
NEXT_PUBLIC_AI_INSIGHT_FEE_RECIPIENT=
AI_INSIGHT_FEE_RECIPIENT=

# ──────────────────────────────────────────────────────────────────────────────
# Deployer / treasury (server-side EOA — NEVER commit)
# Fund with USDC from https://faucet.circle.com (Arc Testnet, USDC)
# ──────────────────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Mainnet wallet generation: run `npm run wallets:mainnet:generate` from web.
# The generator appends private keys only to the ignored root .env and never
# prints them. Use a multisig/cold wallet for MAINNET_TREASURY_ADDRESS.
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_DEPLOYER_ADDRESS=
MAINNET_RESOLVER_PRIVATE_KEY=
MAINNET_RESOLVER_ADDRESS=
MAINNET_TREASURY_ADDRESS=

# Fast market automation
FAST_MARKET_SEED_USDC=1
# Current lean launch: exactly BTC 15m and ETH 15m.
FAST_MARKET_SYMBOLS=BTC,ETH
FAST_MARKET_WINDOWS=15m
FAST_MARKET_POLL_SECONDS=30
FAST_MARKET_RESIDUAL_SWEEP_STATE_FILE=config/fast-market-residual-sweep.state.json
FAST_MARKET_RESIDUAL_SWEEP_INTERVAL_SECONDS=3600
FAST_MARKET_RESIDUAL_SWEEP_RECENT_LIMIT=96
FAST_MARKET_RESIDUAL_SWEEP_EMPTY_RECHECK_SECONDS=43200
FAST_MARKET_RESIDUAL_SWEEP_FULL_RESCAN_SECONDS=604800

# Fast market swarm automation (private-key config is generated locally)
FAST_SWARM_WALLETS_CONFIG=../config/fast-market-swarm.wallets.json
FAST_SWARM_STATE_FILE=../config/fast-market-swarm.state.json
FAST_SWARM_LIVE=0
FAST_SWARM_POLL_SECONDS=20
FAST_SWARM_PARTICIPATION_RATE=0.35
FAST_SWARM_MIN_BET_USDC=0.25
FAST_SWARM_MAX_BET_USDC=1.75
FAST_SWARM_RESERVE_USDC=5
FAST_SWARM_MAX_TX_PER_LOOP=8

# ──────────────────────────────────────────────────────────────────────────────
# Admin gate (web /admin route)
# ADMIN_COOKIE_SECRET signs the EIP-191 session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_ADDRESSES is a comma-separated list of EOAs allowed past the gate;
# the NEXT_PUBLIC_ mirror is read client-side to render the admin link.
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_COOKIE_SECRET=
ADMIN_ADDRESSES=
NEXT_PUBLIC_ADMIN_ADDRESSES=

# ──────────────────────────────────────────────────────────────────────────────
# Circle developer platform (for User-Controlled Wallets + Gas Station)
# Create at https://console.circle.com
# ──────────────────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=                 # 64 hex chars; see CIRCLE_SETUP.md
CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_APP_ID=            # mirror of CIRCLE_APP_ID for the Web SDK
CIRCLE_BLOCKCHAIN=BOTCHAIN-TESTNET    # set to the exact Circle-supported slug
CIRCLE_WALLET_SET_ID=                 # Developer Wallets → Wallet Sets
CIRCLE_GAS_STATION_POLICY=            # policy ID for gasless tx sponsorship

# ──────────────────────────────────────────────────────────────────────────────
# Agent LLMs
# ──────────────────────────────────────────────────────────────────────────────
# Preferred low-cost path: Google Gemini generateContent.
# Free users are forced onto GEMINI_FREE_MODEL; paid users use
# GEMINI_PRO_MODEL unless overridden in code/config. Rotate any key pasted
# into chat or logs before deploying.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_FREE_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3-flash-preview
GEMINI_THINKING_LEVEL=low
GEMINI_TEMPERATURE=0.15
GEMINI_GOOGLE_SEARCH=0

# Paid market insight endpoint (/api/markets/:address/insight). OpenRouter is
# primary; Gemini is the fallback (leave AI_INSIGHT_PROVIDER blank).
# Set =openrouter to disable the Gemini fallback, =gemini for the legacy path.
AI_INSIGHT_PROVIDER=
AI_INSIGHT_TIMEOUT_MS=20000
GEMINI_INSIGHT_MODEL=gemini-3.1-flash-lite
GEMINI_INSIGHT_THINKING_LEVEL=low
GEMINI_INSIGHT_TEMPERATURE=0.15
GEMINI_INSIGHT_GOOGLE_SEARCH=0
# Same Gemini model as the Gemini path, routed through OpenRouter.
OPENROUTER_INSIGHT_MODEL=google/gemini-3.1-flash-lite
AI_INSIGHT_MAX_TOKENS=1200

# Primary path: OpenRouter. BRAIN_PROVIDER=openrouter makes policy.py pick the
# OPENROUTER_* tier models and routes brain.py through OpenRouter; Gemini stays
# as the fallback (BRAIN_FALLBACK=1). The OPENROUTER_*_MODEL slugs mirror the
# Gemini tiers (google/gemini-* = same models, billed via OpenRouter — no Google
# Console account needed). BRAIN_TEMPERATURE / OPENROUTER_REASONING_EFFORT mirror
# GEMINI_TEMPERATURE / GEMINI_THINKING_LEVEL onto the OpenRouter call.
BRAIN_PROVIDER=openrouter
BRAIN_FALLBACK=1
BRAIN_TEMPERATURE=0.15
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_STANDARD_MODEL=google/gemini-3-flash-preview
OPENROUTER_PRO_MODEL=google/gemini-3-flash-preview

# Orchestrator override. Leave blank to let tier policy choose the Gemini model.
BRAIN_MODEL=

# Web-search delegate. Sonar does live web search natively and returns
# citations; the orchestrator calls it as a tool when it decides news
# is relevant. Set BRAIN_WEB_TOOLS=0 to disable web_search entirely
# (cuts spend, OK for CI smoke runs).
BRAIN_SEARCH_MODEL=perplexity/sonar
BRAIN_WEB_TOOLS=1
BRAIN_MAX_TOKENS=1600

# Legacy single-shot path (used only as a fallback if brain.py won't load).
OPENROUTER_MODEL=perplexity/sonar
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# Deadlines for Gamma calls made during server rendering. A bare fetch has no
# timeout, and an unanswered Gamma request used to hang the homepage forever
# (HTTP 200, stream never completes). Polymarket only supplies card artwork, so
# it must never block a render.
POLYMARKET_TIMEOUT_MS=4000
# Total budget for the multi-page overlay scan, so N pages can't serially spend
# N timeouts. Whatever arrived before the budget ran out is still used.
POLYMARKET_SCAN_BUDGET_MS=9000
# Per-dependency deadline for server-rendered pages (lib/with-deadline). A
# stalled read renders a degraded page instead of hanging the request forever.
SSR_DEADLINE_MS=8000
# Postgres fail-fast. The Supabase SESSION pooler (:5432) does not reject when
# it hits its ~15-client cap — it makes new connections WAIT, which turns into
# an SSR hang. Prefer the TRANSACTION pooler (:6543) for serverless; the client
# already sets prepare:false for it.
PG_CONNECT_TIMEOUT_S=10
PG_STATEMENT_TIMEOUT_MS=15000
NEWS_API_KEY=

# Optional user notifications. Users paste their Telegram chat ID in
# /agent/settings; the runner sends messages through this bot.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# On-demand AI insight fee settings (web market page)
# 0.05 USDC is charged on-chain before insight generation.
AI_INSIGHT_FEE_RECIPIENT=
NEXT_PUBLIC_AI_INSIGHT_FEE_RECIPIENT=

# Phase 3: server-side session signer used by the runner. The public address
# is exposed via NEXT_PUBLIC_ so the wizard can authorise it on-chain.
# Generate with `cast wallet new`. Production must use a KMS.
AGENT_SESSION_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Phase A: Agentic economics
# ──────────────────────────────────────────────────────────────────────────────
# Platform treasury EOA — receives protocol fees (0.3% per trade) and
# subscription/profit-share payments. Use the deployer EOA for hackathon.
TREASURY_ADDRESS=

# x402 wrapper for live trading-agent reasoning requests.
# Every live brain request pays this USDC amount before calling the model,
# regardless of subscription tier. Receiver fallback order:
# AGENT_X402_PAY_TO_ADDRESS → X402_PAY_TO_ADDRESS → TREASURY_ADDRESS →
# AI_INSIGHT_FEE_RECIPIENT.
AGENT_X402_REASONING_FEE_USDC=0.01
AGENT_X402_PAY_TO_ADDRESS=
X402_NETWORK=arc-testnet
X402_ASSET=USDC

# Circle Developer-Controlled Wallets: used by the agent runner to sign and
# broadcast transactions on behalf of users without a session key.
NEXT_PUBLIC_AGENT_SESSION_ADDRESS=

# ──────────────────────────────────────────────────────────────────────────────
# Postgres
# Local dev (with docker-compose up -d db): the URL below.
# Production / hackathon: point at a hosted PG (Neon, Supabase, Railway PG).
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://yolo:yolo@localhost:5432/yolo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
REDIS_URL=

# Telegram admin command center (market listing + /create)
# Comma-separated Telegram chat/user IDs allowed to press the listing buttons
# and run admin commands. DM the bot /start to get your chat id. Anyone else is
# refused. Required by scripts/telegram-bot.ts (it won't boot without it).
TELEGRAM_ADMIN_CHAT_ID=
# Initial-liquidity preset buttons (whole USDC), comma-separated. Shared by the
# "List on YOLO" flow and the /create wizard's seed step.
LISTING_SEED_OPTIONS=1,5,10,25
# Deadline preset buttons for /create. Accepts the same spans the parser takes.
CREATE_DEADLINE_OPTIONS=1h,6h,24h,3d,7d,30d
# Long-poll timeout for the VPS bot (scripts/telegram-bot.ts). Only relevant to
# the poller transport — the Vercel webhook ignores it.
TELEGRAM_POLL_SECONDS=30
# Public site origin for "view market" links in Telegram messages.
NEXT_PUBLIC_SITE_URL=https://yolo.markets

# ── Circle Nanopayments (Gateway batched x402) ─────────────────────────────
# Leg B of the payment design: the platform pays third-party x402 services in
# sub-cent USDC, gaslessly, batched through Circle Gateway on Arc (domain 26).
# The payer MUST be an EOA — nanopayments settle as EIP-3009 signatures and
# Circle SCA wallets cannot sign them, so the users' agent wallets can't pay.
# Use a dedicated key: NOT the factory admin, NOT the resolver.
NANOPAY_PAYER_ADDRESS=
NANOPAY_PAYER_PRIVATE_KEY=
NANOPAY_CHAIN=arcTestnet
# Ordered RPC fallback, tried in order. Put quicknode LAST: it sends CORS
# headers (which only the browser needs) but rate-limits eth_call to ~1 per
# period with -32011 'request limit reached', and the Gateway deposit does an
# allowance() read before anything else — so it blocks the whole flow.
NANOPAY_RPC_URLS=https://rpc.blockdaemon.testnet.arc.network,https://arc-testnet.drpc.org,https://rpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network
# web/scripts/nanopay-service.ts (npm run nanopay:service)
NANOPAY_PORT=8090
# Shared secret between the Python agent and the nanopay service. Empty means
# "trust the local socket" — set it in any shared environment.
NANOPAY_SHARED_SECRET=
# Deterministic spend caps, USDC micro-units (6 dec). Enforced in the service
# before any signature is produced; the agent can lower them, never raise them.
NANOPAY_MAX_PAYMENT_MICRO=10000
NANOPAY_DAILY_CAP_MICRO=1000000
# Opt-in switch read by agent/nanopay.py. Default off; unset = no spending.
AGENT_NANOPAY=0
# Leg B wiring: let the agent buy premium Arc RPC when free endpoints
# rate-limit. Paid RPC sits LAST in the fallback order (free is faster);
# set AGENT_NANOPAY_RPC_PRIMARY=1 to put it first.
AGENT_NANOPAY_RPC_PRIMARY=0
# The x402 resource sold as Arc RPC. $0.0001/call.
NANOPAY_RPC_RESOURCE=https://x402.quicknode.com/arc-testnet/

# ── Leg C: YOLO Insight API (x402 seller) ──────────────────────────────────
# app/api/x402/insight — sells one market's agent intelligence for sub-cent
# USDC, settled via Circle Gateway on Arc. Price in USDC micro-units.
X402_INSIGHT_PRICE_MICRO=100
# Where sales are paid. Falls back to AI_INSIGHT_FEE_RECIPIENT then TREASURY_ADDRESS.
X402_INSIGHT_PAY_TO=
# Circle Gateway facilitator origin (verify/settle). NOTE: the seller quickstart
# shows gateway.circle.com, which does NOT resolve — a wrong value surfaces as an
# opaque "fetch failed" at settle time. Testnet is gateway-api-testnet.circle.com;
# mainnet is gateway-api.circle.com.
CIRCLE_GATEWAY_URL=https://gateway-api-testnet.circle.com
# Per-decision metering fee paid by the user's agent before live reasoning.
# Settled as a real Circle Nanopayment when the profile has a payments wallet,
# otherwise as a plain Circle transfer. The legacy default is $0.01; actual
# outside compute costs ~$0.0001, so this is a pricing decision, not a
# technical one — the rail supports either.
AGENT_X402_REASONING_FEE_USDC=0.01
# Default amount the /pay-fee endpoint charges when the caller omits one.
NANOPAY_FEE_MICRO=100

# ── Fast-market trading ────────────────────────────────────────────────────
# Short crypto rounds (15m/1h) are priced, not forecast: agent/fast_signal.py
# compares live spot to the start price embedded in the market's metadata and
# prices P(up) from measured 1m volatility. No model call, so this keeps
# working when the LLM provider is down.
AGENT_FAST_SIGNAL=1
# The runner ticks at this interval and runs a cheap fast-only pass each tick;
# the expensive full pass keeps its own (tier) cadence.
AGENT_FAST_PASS=1
AGENT_FAST_TICK_SECONDS=60
# Fast markets are always among the newest addresses — scanning the whole
# ~8,000-market factory once a minute would cost more RPC than the rest of the
# agent combined.
AGENT_FAST_SCAN_ADDRS=60
# A profile takes the fast path if it looks short-horizon: max time-to-expiry
# under this many hours, or a cadence at or under this many minutes.
AGENT_SHORT_TF_HOURS=6
AGENT_SHORT_TF_CADENCE_MIN=30
# Floor on measured volatility, guarding against overconfidence in an
# unusually quiet window. Never makes the agent more aggressive.
FAST_SIGNAL_MIN_SIGMA_PER_MIN=0.0002
